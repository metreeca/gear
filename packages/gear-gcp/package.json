{
  "name": "@metreeca/gear-gcp",
  "version": "0.4.0",
  "description": "Google Cloud service implementations for @metreeca/gear.",
  "keywords": [
    "typescript",
    "pipeline",
    "etl",
    "gcp",
    "google-cloud"
  ],
  "homepage": "https://metreeca.github.io/gear/",
  "bugs": {
    "url": "https://github.com/metreeca/gear/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/gear.git",
    "directory": "packages/gear-gcp"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./secrets": {
      "@metreeca/source": "./src/secrets.ts",
      "default": "./dist/secrets.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm dist docs node_modules",
    "build": "rm dist && tsc -p tsconfig.build.json",
    "check": "npx vitest --typecheck run"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.2.0",
    "@metreeca/core": "^0.13.0",
    "@metreeca/gear": "^0.4.0",
    "gcp-metadata": "^9.2.1",
    "google-auth-library": "^11.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
