{
  "entryPoints": [
    "packages/*"
  ],
  "entryPointStrategy": "packages",
  "name": "Metreeca Gear",
  "out": "docs",
  "readme": "README.md",
  "hostedBaseUrl": "https://metreeca.github.io/gear/",
  "useFirstParagraphOfCommentAsSummary": true,
  "favicon": "https://metreeca.com/assets/icon.ico",
  "sourceLinkExternal": true,
  "markdownLinkExternal": true,
  "externalSymbolLinkMappings": {
    "global": {
      "SyntaxError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/SyntaxError",
      "TypeError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/TypeError",
      "URL": "https://developer.mozilla.org/en-US/docs/Web/API/URL"
    },
    "typescript": {
      "SyntaxError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/SyntaxError",
      "TypeError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/TypeError",
      "URL": "https://developer.mozilla.org/en-US/docs/Web/API/URL"
    }
  },
  "navigationLinks": {
    "GitHub": "https://github.com/metreeca/gear"
  },
  "githubPages": false,
  "hideGenerator": true,
  "customFooterHtml": "<a href='https://www.metreeca.com/' style='display: flex; align-items: center; gap: 0.25em'><img src='https://metreeca.com/assets/icon.svg' alt='Metreeca' style='width: 1.25em; height: 1.25em;'/><span>Copyright © 2026 Metreeca</span></a>",
  "headings": {
    "readme": false
  },
  "highlightLanguages": [
    "shell",
    "typescript"
  ],
  "packageOptions": {
    "tsconfig": "./tsconfig.build.json",
    "includeVersion": true,
    "sortEntryPoints": false,
    "sort": [
      "source-order"
    ],
    "categorizeByGroup": true,
    "groupOrder": [
      "Variables",
      "Interfaces",
      "Type Aliases",
      "*"
    ]
  }
}
